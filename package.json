{
  "name": "@astralarium/pixi-three",
  "version": "0.3.0-alpha.9",
  "type": "module",
  "description": "Write declarative apps seamlessly blending 2d and 3d components in React",
  "license": "MIT",
  "author": "Mara Kim <mara@astralarium.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astralarium/pixi-three.git"
  },
  "keywords": [
    "pixi",
    "three",
    "react",
    "webgpu"
  ],
  "bugs": {
    "url": "https://github.com/astralarium/pixi-three/issues"
  },
  "homepage": "https://astralarium.github.io/pixi-three",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "concurrently -P \"typedoc --watch --preserveWatchOutput\" \"vite --config vite.pages.config.ts {@}\" --",
    "build": "tsc -b && eslint . && vite build && pnpm pack --out pack/%s-%v.tgz",
    "build:pages": "typedoc && NODE_TLS_REJECT_UNAUTHORIZED=0 vite build --config vite.pages.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --config vite.pages-preview.config.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pixi-three.js",
      "default": "./dist/pixi-three.js"
    }
  },
  "imports": {
    "#*": "./src/*"
  },
  "peerDependencies": {
    "@pixi/react": "^8.0.5",
    "@react-three/fiber": "^10.0.0-alpha.5",
    "fiber-tunnel": "^0.4.1",
    "its-fine": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@base-ui/react": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@pixi/react": "^8.0.5",
    "@react-three/fiber": "10.0.0-alpha.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fiber-tunnel": "^0.4.1",
    "globals": "^17.13.0",
    "its-fine": "^2.1.1",
    "lucide-react": "^1.54.0",
    "next-themes": "^0.4.6",
    "pixi.js": "^8.22.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "typedoc": "^0.28.20",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "three-mesh-bvh": "^0.9.16"
  }
}
